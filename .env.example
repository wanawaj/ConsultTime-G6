# Copy this file to .env for optional local Neon development.
# Never commit the real .env file or share the connection URL in chat.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_ENDPOINT/YOUR_DATABASE?sslmode=require
# Only needed on Render and Cloudflare when NODE_ENV=production.
API_PROXY_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_VALUE
